# Yoyo Collection — configuration
# Copy this file to ".env" and fill in what you need. EVERY setting is optional;
# with none set, the app runs fully open (anyone can view and edit) on port 3000.

# ---- Server ----
# HTTP port (the host assigns this on most platforms — leave unset there).
PORT=3000

# Where the SQLite database file and photo uploads live. Point these at a
# persistent disk/volume in production so redeploys don't wipe your collection.
DB_PATH=data/yoyos.db
UPLOAD_DIR=uploads

# Where Restore puts its scratch folder. Restoring streams the uploaded backup
# to disk rather than holding it in memory, so it briefly needs room for a copy
# of the .zip (up to 200MB) plus the database extracted from it. By default that
# lands next to DB_PATH, which is real disk on every supported setup. Point this
# somewhere else if DB_PATH is on a disk too small to absorb that — a `restore-tmp`
# subdirectory is created inside whatever you name here.
# Avoid a RAM-backed path: /tmp is tmpfs on Armbian, Fedora, recent Ubuntu and
# many SBC images, which would defeat the point.
RESTORE_TMP_DIR=

# Largest backup Restore will accept, in MB (default 8192). The web UI uploads
# a backup in small chunks, so a host's request-size limit doesn't apply; this
# is the only cap. Restore needs free disk for the backup plus its photos.
RESTORE_MAX_MB=

# Largest total a backup may unpack to, in MB (default 16384). Guards against a
# small zip that expands to fill the disk.
RESTORE_EXTRACT_MAX_MB=

# Your time zone, e.g. America/New_York. Only used to date the backup and CSV
# export filenames — without it they follow the server's clock (UTC in Docker),
# so an evening backup in the US is named for tomorrow.
# TZ=America/New_York

# ---- Access control (pick at most one model) ----
# Owner login: the public sees a read-only collection; you log in to edit.
# Setting this enables the login button. Recommended for a public showcase.
ADMIN_PASSWORD=

# Make the whole app read-only (no editing at all, no login).
# Accepts: 1 / true / yes
READ_ONLY=

# Public demo mode: login still works (so visitors can see the owner view), but
# EVERY data-changing request is refused — no edits, deletes, photo uploads, or
# restores. Also adds noindex so the demo stays out of search. Pair with
# ADMIN_PASSWORD (e.g. "demo") and RATE_LIMIT_MAX. Accepts: 1 / true / yes
DEMO_MODE=

# Fully-private instance: HTTP Basic Auth over the ENTIRE app. Set BOTH to
# require a username + password just to view anything.
AUTH_USER=
AUTH_PASS=

# Signs login session tokens. If unset it's derived from ADMIN_PASSWORD, which
# is fine for a single instance; set an explicit random string if you prefer.
SESSION_SECRET=

# Allow embedding the app in an <iframe> on this origin, e.g. https://yoursite.com
# By default only the app's own pages may frame it. Visitors can browse an
# embedded copy, but signing in only works on the app's own address.
FRAME_ANCESTORS=

# Set to 1 when the app sits behind a proxy you run (Passenger on a shared host,
# nginx, Caddy, Traefik, Cloudflare). It makes the app use X-Forwarded-For as
# the visitor's address for the login and request limits. Leave it unset when
# the app is reached directly: then that header could be faked.
TRUST_PROXY=

# Wrong passwords allowed per address in 15 minutes before sign-in pauses
# (default 10). A site-wide ceiling of 100 applies too (LOGIN_FAIL_GLOBAL_MAX).
# Correct sign-ins never count.
LOGIN_FAIL_MAX=

# Rate limiting (per client IP). Off unless RATE_LIMIT_MAX is set. Useful for a
# public demo so a bot can't hammer it. A normal page load is only a handful of
# requests, so 120/min is generous for humans but stops abuse.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=60000

# ---- Carrier tracking (optional) ----
# Enables the "Query ETA" button on the Arrivals page. Add only the carriers you
# use; each needs PRODUCTION OAuth credentials from that carrier's developer site.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
